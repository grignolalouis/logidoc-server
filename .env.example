# HTTP Server
HTTP_ADDR=:7042

# MCP Server
MCP_ADDR=:7043
MCP_TRANSPORT=streamable_http

# MongoDB (internal docker network)
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=logidoc

# ---- LLM Provider ----
# Supported: anthropic, openai, mistral, xai, groq, ollama
#
# Anthropic (Claude):
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-haiku-4-5-20251001
#   LLM_API_KEY=sk-ant-...
#
# OpenAI (GPT):
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
# Mistral:
#   LLM_PROVIDER=mistral
#   LLM_MODEL=mistral-large-latest
#   LLM_API_KEY=...
#
# xAI (Grok):
#   LLM_PROVIDER=xai
#   LLM_MODEL=grok-2
#   LLM_API_KEY=xai-...
#
# Groq:
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
#
# Ollama (local):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2
#   LLM_API_KEY=ollama
#
# Custom OpenAI-compatible:
#   LLM_PROVIDER=custom
#   LLM_MODEL=my-model
#   LLM_API_KEY=...
#   LLM_BASE_URL=https://my-api.example.com/v1

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=

# Optional: override base URL (for custom endpoints)
# LLM_BASE_URL=

# Logger
LOG_LEVEL=debug
LOG_FORMAT=text
