# ---- App ----
# APP_VERSION=1.0.0
# API_KEY=               # optional: set to enable API key auth on /v1/* endpoints

# ---- Ports (docker-compose) ----
# HTTP_PORT=7042
# MCP_PORT=7043
# MONGO_PORT=27042

# ---- HTTP Server ----
HTTP_ADDR=:7042
# HTTP_RATE_LIMIT=100
# HTTP_BODY_LIMIT_MB=50

# ---- MCP Server ----
MCP_ADDR=:7043
MCP_TRANSPORT=streamable_http
# MCP_STDIO=true

# ---- MongoDB ----
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=logidoc

# ---- LLM (structure detection, TOC, chunking) ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
# LLM_BASE_URL=

# ---- Vision (optional, for tables + images) ----
# If not set, the main LLM is used for vision tasks.
# VISION_PROVIDER=anthropic
# VISION_MODEL=claude-sonnet-4-5-20250514
# VISION_API_KEY=          # defaults to LLM_API_KEY
# VISION_BASE_URL=

# ---- Indexer ----
# INDEXER_MAX_PAGES_PER_NODE=20
# INDEXER_ENABLE_TABLE_EXTRACTION=false
# INDEXER_ENABLE_IMAGE_DESCRIPTION=false

# ---- Logger ----
LOG_LEVEL=info
LOG_FORMAT=json
