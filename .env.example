# ---- App ----
# APP_VERSION=1.0.0
# API_KEY=               # optional: set to enable API key auth on /v1/* endpoints

# ---- Ports (docker-compose) ----
# HTTP_PORT=7042
# MCP_PORT=7043
# MONGO_PORT=27042
# MONGO_VERSION=7

# ---- HTTP Server ----
HTTP_ADDR=:7042
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_CORS_ORIGINS=*
# HTTP_RATE_LIMIT=100

# ---- MCP Server ----
MCP_ADDR=:7043
MCP_TRANSPORT=streamable_http
# MCP_STDIO=true         # uncomment for Claude Desktop / Cursor stdio mode

# ---- MongoDB ----
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=logidoc

# ---- LLM Provider ----
# Supported: anthropic, openai, mistral, xai, groq, ollama
#
# Anthropic:   LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-4-5-20251001
# OpenAI:      LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini
# Mistral:     LLM_PROVIDER=mistral    LLM_MODEL=mistral-large-latest
# xAI (Grok):  LLM_PROVIDER=xai        LLM_MODEL=grok-2
# Groq:        LLM_PROVIDER=groq       LLM_MODEL=llama-3.3-70b-versatile
# Ollama:      LLM_PROVIDER=ollama     LLM_MODEL=llama3.2  LLM_API_KEY=ollama
# Custom:      LLM_PROVIDER=custom     LLM_BASE_URL=https://my-api.com/v1

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
# LLM_BASE_URL=

# ---- Logger ----
LOG_LEVEL=info            # debug, info, warn, error
LOG_FORMAT=json           # json, text
