# ---- Ports ----
HTTP_PORT=7042
MCP_PORT=7043
MONGO_PORT=27042

# ---- App ----
APP_VERSION=1.0.0
API_KEY=your-strong-api-key

# ---- HTTP Server ----
HTTP_ADDR=:7042
HTTP_CORS_ORIGINS=https://your-domain.com
HTTP_RATE_LIMIT=60

# ---- MCP Server ----
MCP_ADDR=:7043
MCP_TRANSPORT=streamable_http

# ---- MongoDB ----
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=logidoc

# ---- LLM ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=

# ---- Logger ----
LOG_LEVEL=info
LOG_FORMAT=json
