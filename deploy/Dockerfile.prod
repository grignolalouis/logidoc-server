FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /logidoc-server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates poppler-utils
COPY --from=builder /logidoc-server /usr/local/bin/logidoc-server
EXPOSE 7042 7043
ENTRYPOINT ["logidoc-server"]
